{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TYL",
  "version": "0.1.0-beta.1",
  "identifier": "com.zzyjoy.tyl",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "popup",
        "title": "TYL",
        "url": "/popup.html",
        "width": 560,
        "height": 260,
        "minWidth": 400,
        "minHeight": 180,
        "visible": false,
        "focus": true,
        "focusable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "zzy_joy",
    "copyright": "Copyright © 2026 zzy_joy",
    "category": "Productivity",
    "shortDescription": "轻量、低延迟、不污染剪贴板的 Windows 划词翻译工具",
    "longDescription": "TYL 优先通过 Windows UI Automation 直接读取选区，并提供低内存 WebView 生命周期、多翻译引擎、独立词典与安全替换能力。",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
